# Echo Barrier Hub — environment template.
# Copy to .env.local and fill with the ROTATED keys. NEVER commit .env.local.
#
# Supabase (ops project "Hubspot Shipping and Stocks" — korylyniwsqtsvzuzydg).
# The anon/publishable key is the ONLY Supabase key that may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY. Bypasses RLS — never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot private-app token (server-side only). Used by the quote flow.
HUBSPOT_ACCESS_TOKEN=
# HubSpot portal/account id — used only to deep-link to a deal after quote upload.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# n8n (Dave's stock + invite workflows). Server-side only.
N8N_ECHOBARRIER_API_KEY=
N8N_INVITE_WEBHOOK_URL=

# n8n webhook the Hub POSTs to when an EB-Group approver approves a PO. n8n then
# creates the EB-Group Xero PO, emails EB SRO, and posts the Slack notice — so Xero
# and Slack credentials stay in n8n, never in this (public) repo. Server-side only.
# The secret (optional) is sent as the `x-hub-secret` header for the workflow to verify.
N8N_PO_APPROVED_WEBHOOK_URL=

# Tells SRO (Juraj) that a depot order has reached them and is waiting to be
# evaluated. Fires when a DEPOT_TO_EB_GROUP leg is approved and its
# EB_GROUP_TO_SRO child is raised. n8n owns the wording; the Hub decides who
# gets it, so the test switch above cannot be bypassed by a workflow holding
# its own copy of an address. SRO_NOTIFY_TO defaults to juraj@echobarrier.eu.
N8N_SRO_NOTIFY_WEBHOOK_URL=
N8N_SRO_NOTIFY_WEBHOOK_SECRET=
SRO_NOTIFY_TO=
SRO_NOTIFY_CC=

# Sends the manufacturing purchase order to Bamida, with the PDF attached and
# a link back into the Hub. n8n picks the wording from the `template` field:
# `standard`, or `materials_short` when the Hub can see they do not have
# enough materials. Short materials never stop the send. Without BAMIDA_PO_TO
# the Hub refuses to send rather than guessing an address.
N8N_BAMIDA_PO_WEBHOOK_URL=
N8N_BAMIDA_PO_WEBHOOK_SECRET=
BAMIDA_PO_TO=
BAMIDA_PO_CC=
BAMIDA_PO_BCC=

# How long Bamida's link stays good, in days. Generous on purpose: they come
# back to it once for their dates and again weeks later to say the order is
# finished, and a link that dies in between puts a person back in the middle.
# Defaults to 180.
MANUFACTURING_LINK_DAYS=

# Where this Hub lives, for links inside emails (an email has no request to
# take an origin from). Defaults to https://hub.echobarrier.com. Set it to
# http://localhost:3000 when testing a send from a laptop.
NEXT_PUBLIC_HUB_BASE_URL=
N8N_PO_APPROVED_WEBHOOK_SECRET=

# Manufacturing Supabase project (mfg "BOM/landed-cost/FX" — cdkpczinzhykcdbfoobn).
# Read-only, SERVER-SIDE only (BOM module). RLS is service-role-only on that project.
MFG_SUPABASE_URL=
MFG_SUPABASE_SERVICE_ROLE_KEY=

# Cargo Partner (Transport module — shipment lookup). Server-side only. ROTATE before use.
# NB: wrap any value containing '#' or spaces in DOUBLE QUOTES, or the dotenv loader
# truncates it at the '#' (e.g. CARGO_PARTNER_PASSWORD="ab#cd").
CARGO_PARTNER_USERNAME=
CARGO_PARTNER_PASSWORD=
CARGO_PARTNER_CLIENT_ID=
CARGO_PARTNER_CLIENT_SECRET=

# E2E (Playwright) — a Supabase auth user the tests log in as. Needs a profile +
# capabilities to exercise gated modules.
E2E_USERNAME=
E2E_PASSWORD=
# Optional: a SCOPED (quotes-only) user → activates the negative-gating specs.
# Your existing non-admin already fits (quotes.view + quotes.create only).
E2E_LIMITED_USERNAME=
E2E_LIMITED_PASSWORD=
# Optional: a real HubSpot deal id in the test user's pipeline → activates the
# read-only Quotes specs (also needs HUBSPOT_ACCESS_TOKEN above). Never submitted.
E2E_DEAL_ID=
# Optional: a deal that ALREADY has an invoice → activates the read-only invoice
# editor specs (the attachments dropzone and the tracking state). Those specs
# only render and drag; nothing is ever uploaded.
E2E_INVOICE_DEAL_ID=

# US customer invoicing: TaxJar sales-tax calculation + n8n Xero authorize leg
# Sandbox by default. Go live by setting TAXJAR_API_TOKEN and NOTHING else: its
# presence is the switch, and the host then defaults to https://api.taxjar.com.
# TAXJAR_API_BASE is a host override for testing and should stay blank. Every
# request path already starts with /v2, so a base ending in /v2 (which is what
# TaxJar's own docs show) produces /v2/v2/... and 404s on every call.
TAXJAR_SANDBOX_TOKEN=
TAXJAR_API_TOKEN=
TAXJAR_API_BASE=
N8N_CUSTOMER_INVOICE_WEBHOOK_URL=
N8N_CUSTOMER_INVOICE_WEBHOOK_SECRET=


# Customer invoice: the remittance block printed on the PDF, and the test-send
# override. These live in the environment and NEVER in the repo, which is
# public: an account number on a customer's invoice is seen by one accounts
# payable department, the same number in a public git history is the standard
# raw material for invoice-redirection fraud.
#
# Without BANK_NAME, ROUTING_NUMBER and ACCOUNT_NUMBER the PDF prints visible
# placeholders and emailing a customer is refused outright, because an invoice
# that does not say how to pay it is worse than no invoice.
# Headings on the invoice match the bank's own confirmation letter, so an
# accounts-payable clerk copying them into a payment form sees labels they
# recognise. Quote any value containing spaces.
INVOICE_REMIT_ACCOUNT_NAME=
INVOICE_REMIT_BANK_NAME=
# The bank's address, pipe-separated for line breaks.
INVOICE_REMIT_BANK_ADDRESS=
INVOICE_REMIT_ROUTING_NUMBER=
INVOICE_REMIT_ACCOUNT_NUMBER=
INVOICE_SELLER_EIN=

# When set, EVERY invoice email is redirected here instead of the customer, and
# the invoice row records that the send was a test. Never set in production.
INVOICE_EMAIL_TEST_RECIPIENT=

# THE HUB-WIDE TEST SWITCH. While this is set, every email the Hub sends goes
# here and nowhere else: the `to` is replaced and cc/bcc are CLEARED, not
# redirected, so a real address in a cc cannot still reach a supplier. The
# body prints who it would have gone to, so a test send is verifiable rather
# than merely safe. Accepts more than one address, comma-separated.
# NEVER set in production.
HUB_EMAIL_TEST_RECIPIENT=

# E2E: lets the two specs that raise and approve a purchase order chain run.
# Each such run spends one live EBUSA and one live EBGRP number out of the
# series Xero purchase orders are numbered from, and deleting the rows does not
# give the numbers back, so every run leaves a permanent gap in the series.
E2E_SPEND_PO_NUMBERS=

# Jack, the ANZ AI sales agent: POST /api/agent/quote. Server-side only, and
# set for the Netlify PRODUCTION context only, never deploy previews (previews
# run against production data).
# AGENT_QUOTE_SECRET is 32 random bytes as hex, generated inside the script that
# writes Netlify env and the n8n credential, never printed. During a rotation
# the old value moves to AGENT_QUOTE_SECRET_PREVIOUS; both unset means every
# call is refused.
AGENT_QUOTE_SECRET=
AGENT_QUOTE_SECRET_PREVIOUS=
# The Supabase auth user the route mints a per-request session for. No password
# is stored anywhere; the session comes from an admin magic link verified in
# process. JACK_USER_ID is that user's uuid.
#
# JACK_AUTH_EMAIL is the LOGIN identity and it must be an address that receives
# no mail. Anyone can ask Supabase for a magic link or a password reset for a
# known address with the public anon key, so a deliverable one hands a full Jack
# session to whoever reads that mailbox. no-mail.echobarrier.com has no MX, no A
# record and no wildcard. This is NOT jack@echobarrier.com.
#
# JACK_USER_ID is also what the Hub refuses a browser session for (middleware
# and /auth/callback), so leaving it unset turns that lockout off as well as
# breaking the route. Set it wherever the agent route is enabled.
JACK_USER_ID=
JACK_AUTH_EMAIL=jack.agent@no-mail.echobarrier.com
# The MAIL identity, printed on the quote as the address to reply to. The Gmail
# alias the ANZ Mailer sends as. Unset omits the sender email from the quote
# rather than printing the no-mail login address.
JACK_SENDER_EMAIL=jack@echobarrier.com
# Quotes above this AUD total are refused (AMOUNT_CEILING) and go to a person.
# Defaults to 50000.
AGENT_QUOTE_AMOUNT_CEILING=50000
